# Copie este arquivo para .env antes de subir o Docker Compose:
#   cp .env.example .env
# O arquivo .env não deve ser commitado. Troque todos os valores abaixo.

# Banco de dados
POSTGRES_DB=authdb
DB_URL=jdbc:postgresql://postgres:5432/authdb
DB_USER=authuser
DB_PASSWORD=troque-esta-senha

# JWT (use pelo menos 32 caracteres aleatórios)
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-com-32-caracteres
JWT_EXPIRATION=3600000

# Administrador inicial, criado apenas se ainda não existir
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha-admin

# Perfil ativo dentro do contêiner (prod exige JWT_SECRET, DB_* e ADMIN_*)
SPRING_PROFILES_ACTIVE=prod
